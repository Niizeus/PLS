{
  "permissions": {
    "allow": [
      "Bash(npx tsc:*)",
      "Bash(npm run build:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(ls:*)"
    ],
    "deny": [
      "Read(**/node_modules/**)",
      "Read(**/.venv/**)",
      "Read(**/.venv-cosy/**)",
      "Read(**/site-packages/**)",
      "Read(**/dist/**)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo '{\"systemMessage\":\"Rappel PLS : mets a jour la doc concernee (README / docs / AGENTS.md) dans le meme commit que ton changement. Voir AGENTS.md section 0.\"}'"
          }
        ]
      }
    ]
  }
}