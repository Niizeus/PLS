# --- Dépendances (jamais sur GitHub, réinstallées avec `npm install`) ---
node_modules/
.pnp
.pnp.js

# --- Build / sortie de compilation ---
dist/
dist-ssr/
build/
*.local

# --- Tauri (export .exe, phase 2) ---
src-tauri/target/
src-tauri/gen/

# --- Logs & caches ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.vite/
.cache/

# --- Variables d'environnement (secrets, ne jamais partager) ---
.env
.env.local
.env.*.local

# --- Fichiers d'éditeur / OS ---
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
desktop.ini

# --- Divers ---
*.tmp
coverage/

# --- Copies de secours de l'editeur PLS (filet local, l'historique partage = les commits) ---
src/data/.backups/
